# ReachTrail LOCAL DEVELOPMENT config
#
# Copy this file to `assets/config/.env`.
#
# IMPORTANT: `.env` is NEVER bundled into the app. It is not listed in the
# pubspec asset list, so it is not readable at runtime and never ends up inside
# an .aab / .ipa. It exists only as a convenient place to keep your local
# development values.
#
# Release builds read `assets/config/.vars`, which contains no secrets.
# The Yahoo! Local Search key lives only on the API proxy server.
#
# To call the Yahoo API directly during local development (debug builds only),
# pass the key on the command line:
#
#   flutter run --dart-define=YAHOO_API_KEY=<your key>
#
# In a release build with no YAHOO_PROXY_BASE_URL configured, the app refuses to
# search rather than calling Yahoo with a client-side key.
PLACE_SEARCH_PROVIDER=yahoo
YAHOO_API_KEY=your_yahoo_client_id
YAHOO_PROXY_BASE_URL=https://api.reachtrail.riumu.net/yahoo/localSearch
API_BASE_URL=https://api.reachtrail.riumu.net
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_MACOS_CLIENT_ID=your_google_macos_client_id.apps.googleusercontent.com
